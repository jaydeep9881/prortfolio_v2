<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#081e36"/>
      <stop offset="100%" stop-color="#04101e"/>
    </linearGradient>
    <linearGradient id="cardGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0c2d52" stop-opacity="0.9"/>
      <stop offset="100%" stop-color="#071b33" stop-opacity="0.9"/>
    </linearGradient>
    <linearGradient id="cyanGrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#00f2fe"/>
      <stop offset="100%" stop-color="#4facfe"/>
    </linearGradient>
    <linearGradient id="blueGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#38bdf8"/>
      <stop offset="100%" stop-color="#0284c7"/>
    </linearGradient>
  </defs>

  <!-- Base Window -->
  <rect width="800" height="500" rx="12" fill="url(#bgGrad)"/>
  
  <!-- Window Header Bar -->
  <rect width="800" height="42" fill="#030b14"/>
  <circle cx="24" cy="21" r="6" fill="#ef4444"/>
  <circle cx="44" cy="21" r="6" fill="#f59e0b"/>
  <circle cx="64" cy="21" r="6" fill="#10b981"/>
  <text x="400" y="26" fill="#94a3b8" font-family="'Segoe UI', sans-serif" font-size="13" text-anchor="middle" font-weight="600">HRMS Portal — Spring Boot + React Dashboard</text>

  <!-- Left Sidebar -->
  <rect x="0" y="42" width="180" height="458" fill="#061629"/>
  <rect x="18" y="65" width="144" height="32" rx="6" fill="#0ea5e9" fill-opacity="0.2"/>
  <text x="35" y="86" fill="#38bdf8" font-family="'Segoe UI', sans-serif" font-size="13" font-weight="bold">⚡ Overview</text>
  <text x="35" y="125" fill="#64748b" font-family="'Segoe UI', sans-serif" font-size="13">👥 Employees</text>
  <text x="35" y="160" fill="#64748b" font-family="'Segoe UI', sans-serif" font-size="13">📅 Leave Tracker</text>
  <text x="35" y="195" fill="#64748b" font-family="'Segoe UI', sans-serif" font-size="13">🛡️ Role Security</text>
  <text x="35" y="230" fill="#64748b" font-family="'Segoe UI', sans-serif" font-size="13">📊 Reports</text>

  <!-- Metric Cards -->
  <!-- Card 1 -->
  <rect x="204" y="65" width="170" height="90" rx="8" fill="url(#cardGrad)" stroke="#38bdf8" stroke-opacity="0.3"/>
  <text x="220" y="92" fill="#94a3b8" font-family="'Segoe UI', sans-serif" font-size="12">Total Staff</text>
  <text x="220" y="125" fill="#f8fafc" font-family="'Segoe UI', sans-serif" font-size="28" font-weight="bold">1,248</text>
  <text x="220" y="145" fill="#10b981" font-family="'Segoe UI', sans-serif" font-size="11">↑ 12% this month</text>

  <!-- Card 2 -->
  <rect x="394" y="65" width="170" height="90" rx="8" fill="url(#cardGrad)" stroke="#38bdf8" stroke-opacity="0.3"/>
  <text x="410" y="92" fill="#94a3b8" font-family="'Segoe UI', sans-serif" font-size="12">On Leave Today</text>
  <text x="410" y="125" fill="#38bdf8" font-family="'Segoe UI', sans-serif" font-size="28" font-weight="bold">24</text>
  <text x="410" y="145" fill="#94a3b8" font-family="'Segoe UI', sans-serif" font-size="11">All approved</text>

  <!-- Card 3 -->
  <rect x="584" y="65" width="186" height="90" rx="8" fill="url(#cardGrad)" stroke="#38bdf8" stroke-opacity="0.3"/>
  <text x="600" y="92" fill="#94a3b8" font-family="'Segoe UI', sans-serif" font-size="12">Security Level</text>
  <text x="600" y="125" fill="#22d3ee" font-family="'Segoe UI', sans-serif" font-size="22" font-weight="bold">Spring Sec 6</text>
  <text x="600" y="145" fill="#10b981" font-family="'Segoe UI', sans-serif" font-size="11">RBAC Active</text>

  <!-- Chart Area -->
  <rect x="204" y="175" width="566" height="195" rx="8" fill="url(#cardGrad)" stroke="#38bdf8" stroke-opacity="0.2"/>
  <text x="225" y="205" fill="#f8fafc" font-family="'Segoe UI', sans-serif" font-size="14" font-weight="bold">Attendance &amp; Payroll Metrics</text>
  
  <!-- Bar chart visual -->
  <rect x="235" y="290" width="35" height="55" rx="4" fill="#0ea5e9"/>
  <rect x="290" y="260" width="35" height="85" rx="4" fill="#0ea5e9"/>
  <rect x="345" y="240" width="35" height="105" rx="4" fill="#38bdf8"/>
  <rect x="400" y="220" width="35" height="125" rx="4" fill="url(#cyanGrad)"/>
  <rect x="455" y="250" width="35" height="95" rx="4" fill="#0ea5e9"/>
  <rect x="510" y="235" width="35" height="110" rx="4" fill="#38bdf8"/>
  <rect x="565" y="210" width="35" height="135" rx="4" fill="url(#cyanGrad)"/>
  <rect x="620" y="240" width="35" height="105" rx="4" fill="#0ea5e9"/>
  <rect x="675" y="225" width="35" height="120" rx="4" fill="url(#cyanGrad)"/>

  <!-- Bottom Table row preview -->
  <rect x="204" y="385" width="566" height="95" rx="8" fill="#06182c" stroke="#38bdf8" stroke-opacity="0.2"/>
  <text x="225" y="415" fill="#38bdf8" font-family="'Segoe UI', sans-serif" font-size="13" font-weight="bold">Recent Employee Activity</text>
  <text x="225" y="445" fill="#94a3b8" font-family="'Segoe UI', sans-serif" font-size="12">EMP-0842 · Sarah Jenkins · Tech Lead · Leave Request approved</text>
  <text x="225" y="465" fill="#94a3b8" font-family="'Segoe UI', sans-serif" font-size="12">EMP-0911 · Rahul Sharma · Senior SDE · Profile updated via REST API</text>
</svg>