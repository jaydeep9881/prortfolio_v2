<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="bookBg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#07182c"/>
      <stop offset="100%" stop-color="#030b14"/>
    </linearGradient>
  </defs>

  <rect width="800" height="500" rx="12" fill="url(#bookBg)"/>
  <rect width="800" height="42" fill="#030b14"/>
  <circle cx="24" cy="21" r="6" fill="#ef4444"/>
  <circle cx="44" cy="21" r="6" fill="#f59e0b"/>
  <circle cx="64" cy="21" r="6" fill="#10b981"/>
  <text x="400" y="26" fill="#94a3b8" font-family="'Segoe UI', sans-serif" font-size="13" text-anchor="middle" font-weight="600">BookNest Online Bookstore — Django &amp; PostgreSQL</text>

  <!-- Banner -->
  <rect x="25" y="65" width="750" height="120" rx="10" fill="#08203c" stroke="#38bdf8" stroke-opacity="0.3"/>
  <text x="50" y="105" fill="#38bdf8" font-family="'Segoe UI', sans-serif" font-size="22" font-weight="bold">📚 Read, Discover, Master Your Craft</text>
  <text x="50" y="135" fill="#94a3b8" font-family="'Segoe UI', sans-serif" font-size="13">Over 50,000+ developer classics, architectural guides and computer science literature.</text>
  <text x="50" y="160" fill="#22d3ee" font-family="'Segoe UI', sans-serif" font-size="12" font-weight="bold">REST APIs · PostgreSQL Full-Text Search · Secure Auth</text>

  <!-- Book Showcase Grid -->
  <!-- Book 1 -->
  <rect x="25" y="205" width="170" height="265" rx="8" fill="#061629" stroke="#38bdf8" stroke-opacity="0.2"/>
  <rect x="40" y="220" width="140" height="130" rx="4" fill="#0d2b4f"/>
  <text x="110" y="290" fill="#38bdf8" font-family="'Segoe UI', sans-serif" font-size="30" text-anchor="middle">📖</text>
  <text x="40" y="375" fill="#f8fafc" font-family="'Segoe UI', sans-serif" font-size="13" font-weight="bold">Clean Code</text>
  <text x="40" y="395" fill="#94a3b8" font-family="'Segoe UI', sans-serif" font-size="11">Robert C. Martin</text>
  <text x="40" y="420" fill="#38bdf8" font-family="'Segoe UI', sans-serif" font-size="14" font-weight="bold">$29.99</text>
  <rect x="40" y="435" width="140" height="24" rx="4" fill="#0ea5e9"/>
  <text x="110" y="451" fill="#ffffff" font-family="'Segoe UI', sans-serif" font-size="10" font-weight="bold" text-anchor="middle">BUY NOW</text>

  <!-- Book 2 -->
  <rect x="218" y="205" width="170" height="265" rx="8" fill="#061629" stroke="#38bdf8" stroke-opacity="0.2"/>
  <rect x="233" y="220" width="140" height="130" rx="4" fill="#0d2b4f"/>
  <text x="303" y="290" fill="#38bdf8" font-family="'Segoe UI', sans-serif" font-size="30" text-anchor="middle">☕</text>
  <text x="233" y="375" fill="#f8fafc" font-family="'Segoe UI', sans-serif" font-size="13" font-weight="bold">Effective Java</text>
  <text x="233" y="395" fill="#94a3b8" font-family="'Segoe UI', sans-serif" font-size="11">Joshua Bloch</text>
  <text x="233" y="420" fill="#38bdf8" font-family="'Segoe UI', sans-serif" font-size="14" font-weight="bold">$38.50</text>
  <rect x="233" y="435" width="140" height="24" rx="4" fill="#0ea5e9"/>
  <text x="303" y="451" fill="#ffffff" font-family="'Segoe UI', sans-serif" font-size="10" font-weight="bold" text-anchor="middle">BUY NOW</text>

  <!-- Book 3 -->
  <rect x="412" y="205" width="170" height="265" rx="8" fill="#061629" stroke="#38bdf8" stroke-opacity="0.2"/>
  <rect x="427" y="220" width="140" height="130" rx="4" fill="#0d2b4f"/>
  <text x="497" y="290" fill="#38bdf8" font-family="'Segoe UI', sans-serif" font-size="30" text-anchor="middle">🌐</text>
  <text x="427" y="375" fill="#f8fafc" font-family="'Segoe UI', sans-serif" font-size="13" font-weight="bold">Designing Systems</text>
  <text x="427" y="395" fill="#94a3b8" font-family="'Segoe UI', sans-serif" font-size="11">Martin Kleppmann</text>
  <text x="427" y="420" fill="#38bdf8" font-family="'Segoe UI', sans-serif" font-size="14" font-weight="bold">$44.00</text>
  <rect x="427" y="435" width="140" height="24" rx="4" fill="#0ea5e9"/>
  <text x="497" y="451" fill="#ffffff" font-family="'Segoe UI', sans-serif" font-size="10" font-weight="bold" text-anchor="middle">BUY NOW</text>

  <!-- Book 4 -->
  <rect x="605" y="205" width="170" height="265" rx="8" fill="#061629" stroke="#38bdf8" stroke-opacity="0.2"/>
  <rect x="620" y="220" width="140" height="130" rx="4" fill="#0d2b4f"/>
  <text x="690" y="290" fill="#38bdf8" font-family="'Segoe UI', sans-serif" font-size="30" text-anchor="middle">🐍</text>
  <text x="620" y="375" fill="#f8fafc" font-family="'Segoe UI', sans-serif" font-size="13" font-weight="bold">Django for APIs</text>
  <text x="620" y="395" fill="#94a3b8" font-family="'Segoe UI', sans-serif" font-size="11">William S. Vincent</text>
  <text x="620" y="420" fill="#38bdf8" font-family="'Segoe UI', sans-serif" font-size="14" font-weight="bold">$24.99</text>
  <rect x="620" y="435" width="140" height="24" rx="4" fill="#0ea5e9"/>
  <text x="690" y="451" fill="#ffffff" font-family="'Segoe UI', sans-serif" font-size="10" font-weight="bold" text-anchor="middle">BUY NOW</text>
</svg>